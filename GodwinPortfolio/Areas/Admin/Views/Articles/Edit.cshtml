@model GodwinPortfolio.DTOs.ArticleRequest

@{
    ViewData["Title"] = "Edit Article";
}

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-lg-9">

            <div class="d-flex justify-content-between align-items-center mb-4">

                <div>
                    <h1 class="display-6 fw-bold">
                        Edit Article
                    </h1>

                    <p class="text-muted mb-0">
                        Update your article content and publication status.
                    </p>
                </div>

                <a asp-area="Admin"
                   asp-controller="Articles"
                   asp-action="Index"
                   class="btn btn-outline-secondary">
                    Back
                </a>

            </div>

            <div class="card border-0 shadow-sm">

                <div class="card-body p-4">

                    <form asp-area="Admin"
                          asp-controller="Articles"
                          asp-action="Edit"
                          asp-route-id="@ViewBag.ArticleId"
                          method="post">

                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly"
                             class="alert alert-danger">
                        </div>

                        <div class="mb-4">

                            <label asp-for="Title"
                                   class="form-label fw-semibold">
                                Article Title
                            </label>

                            <input asp-for="Title"
                                   class="form-control form-control-lg" />

                            <span asp-validation-for="Title"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="mb-4">

                            <label asp-for="Slug"
                                   class="form-label fw-semibold">
                                Slug
                            </label>

                            <input asp-for="Slug"
                                   class="form-control" />

                            <span asp-validation-for="Slug"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="mb-4">

                            <label asp-for="Summary"
                                   class="form-label fw-semibold">
                                Summary
                            </label>

                            <textarea asp-for="Summary"
                                      class="form-control"
                                      rows="4"></textarea>

                            <span asp-validation-for="Summary"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="mb-4">

                            <label asp-for="Content"
                                   class="form-label fw-semibold">
                                Article Content
                            </label>

                            <textarea asp-for="Content"
                                      class="form-control"
                                      rows="18"></textarea>

                            <span asp-validation-for="Content"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="form-check form-switch mb-4">

                            <input asp-for="IsPublished"
                                   class="form-check-input"
                                   role="switch" />

                            <label asp-for="IsPublished"
                                   class="form-check-label">
                                Published
                            </label>

                        </div>

                        <div class="d-flex gap-2">

                            <button type="submit"
                                    class="btn btn-primary">
                                Save Changes
                            </button>

                            <a asp-area="Admin"
                               asp-controller="Articles"
                               asp-action="Index"
                               class="btn btn-outline-secondary">
                                Cancel
                            </a>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}