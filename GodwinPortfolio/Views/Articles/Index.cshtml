@model IReadOnlyList<GodwinPortfolio.DTOs.ArticleResponse>

@{
    ViewData["Title"] = "Articles";
}

<div class="container py-5">

    <div class="mb-5">
        <h1 class="display-5 fw-bold">
            Articles
        </h1>

        <p class="text-muted">
            Thoughts, insights and technical articles.
        </p>
    </div>

    @if (Model is null || Model.Count == 0)
    {
        <div class="alert alert-info">
            No published articles are available.
        </div>
    }
    else
    {
        <div class="row g-4">

            @foreach (var article in Model)
            {
                <div class="col-md-6 col-lg-4">

                    <div class="card h-100 border-0 shadow-sm">

                        <div class="card-body d-flex flex-column">

                            @if (article.PublishedAt.HasValue)
                            {
                                <small class="text-muted mb-2">
                                    @article.PublishedAt.Value
                                </small>
                            }

                            <h2 class="h4 fw-bold">
                                @article.Title
                            </h2>

                            <p class="text-muted">
                                @article.Summary
                            </p>

                            <div class="mt-auto">

                                <a asp-controller="Articles"
                                   asp-action="Details"
                                   asp-route-slug="@article.Slug"
                                   class="btn btn-primary">
                                    Read Article
                                </a>

                            </div>

                        </div>

                    </div>

                </div>
            }

        </div>
    }

</div>