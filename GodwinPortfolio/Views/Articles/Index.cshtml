@model IReadOnlyList<GodwinPortfolio.DTOs.Article.ArticleResponse>

@{
    ViewData["Title"] = "Articles";
}

<div class="container py-5">
    <div class="mb-5">
        <h1 class="fw-bold">Articles</h1>
        <p class="text-muted">
            Insights, ideas and technical articles.
        </p>
    </div>

    @if (Model.Count == 0)
    {
        <div class="alert alert-info">
            No articles available.
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var article in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <article class="card h-100 border-0 shadow-sm">
                        <div class="card-body d-flex flex-column">
                            <small class="text-muted mb-2">
                                @(article.PublishedAt?.ToString("dd MMM yyyy"))
                            </small>

                            <h2 class="h4 fw-bold">
                                @article.Title
                            </h2>

                            <p class="text-muted">
                                @article.Summary
                            </p>

                            <div class="mt-auto">
                                <a asp-action="Details"
                                   asp-route-slug="@article.Slug"
                                   class="btn btn-primary">
                                    Read Article
                                </a>
                            </div>
                        </div>
                    </article>
                </div>
            }
        </div>
    }
</div>