@model GodwinPortfolio.Models.CompanyContact

@{
    ViewData["Title"] = "Contact Us";
}

<section class="contact-page py-5">
    <div class="container">

        <div class="text-center mb-5">
            <span class="text-primary fw-semibold">CONTACT US</span>

            <h1 class="display-5 fw-bold mt-2">
                Let's Work Together
            </h1>

            <p class="text-muted mx-auto" style="max-width: 700px;">
                @Model.Description
            </p>
        </div>

        <div class="row g-4">

            <div class="col-lg-7">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body p-4 p-lg-5">

                        <h2 class="h3 fw-bold mb-4">
                            @Model.CompanyName
                        </h2>

                        <div class="mb-4">
                            <h3 class="h6 text-muted">
                                Address
                            </h3>

                            <p class="mb-0">
                                @Model.Address<br />
                                @Model.City<br />
                                @Model.Country
                            </p>
                        </div>

                        <div class="mb-4">
                            <h3 class="h6 text-muted">
                                Email
                            </h3>

                            <a href="mailto:@Model.Email">
                                @Model.Email
                            </a>
                        </div>

                        <div class="mb-4">
                            <h3 class="h6 text-muted">
                                Phone
                            </h3>

                            <a href="tel:@Model.Phone">
                                @Model.Phone
                            </a>
                        </div>

                        <div>
                            <h3 class="h6 text-muted">
                                Business Hours
                            </h3>

                            <p class="mb-0">
                                @Model.BusinessHours
                            </p>
                        </div>

                    </div>
                </div>
            </div>

            <div class="col-lg-5">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body p-4 p-lg-5">

                        <h2 class="h4 fw-bold mb-4">
                            Connect With Us
                        </h2>

                        @if (!string.IsNullOrWhiteSpace(Model.Website))
                        {
                            <a href="@Model.Website"
                               target="_blank"
                               rel="noopener noreferrer"
                               class="d-block mb-3">
                                Website
                            </a>
                        }

                        @if (!string.IsNullOrWhiteSpace(Model.LinkedInUrl))
                        {
                            <a href="@Model.LinkedInUrl"
                               target="_blank"
                               rel="noopener noreferrer"
                               class="d-block mb-3">
                                LinkedIn
                            </a>
                        }

                        @if (!string.IsNullOrWhiteSpace(Model.GitHubUrl))
                        {
                            <a href="@Model.GitHubUrl"
                               target="_blank"
                               rel="noopener noreferrer"
                               class="d-block">
                                GitHub
                            </a>
                        }

                    </div>
                </div>
            </div>

        </div>

    </div>
</section>