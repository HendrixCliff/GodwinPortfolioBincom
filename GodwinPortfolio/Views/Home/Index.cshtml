@model GodwinPortfolio.Models.HomeIndexViewModel

@{
    ViewData["Title"] = "Home";
}

<section class="hero-section">
    <div class="container">

        <div class="row align-items-center min-vh-75">

            <div class="col-lg-8">

                <span class="badge bg-primary mb-3">
                    @Model.Profile.Title
                </span>

                <h1 class="display-3 fw-bold">
                    @Model.Profile.Name
                </h1>

                <p class="lead mt-4">
                    @Model.Profile.Summary
                </p>

                <div class="mt-4">
                    <a asp-controller="Home"
                       asp-action="Projects"
                       class="btn btn-primary btn-lg me-2">
                        View My Projects
                    </a>

                    <a asp-controller="Home"
                       asp-action="TaxCalculator"
                       class="btn btn-outline-light btn-lg">
                        Try Tax Calculator
                    </a>
                </div>

            </div>

            <div class="col-lg-4">

                <div class="profile-card shadow-lg">

                    <h3>Backend Engineering</h3>

                    <p>
                        Building secure, scalable and maintainable
                        backend systems using modern .NET technologies.
                    </p>

                    <hr />

                    <p class="mb-1">
                        <strong>Location:</strong>
                    </p>

                    <p>
                        @Model.Profile.Location
                    </p>

                    <p class="mb-1">
                        <strong>Email:</strong>
                    </p>

                    <p>
                        @Model.Profile.Email
                    </p>

                </div>

            </div>

        </div>

    </div>
</section>

<section class="py-5">

    <div class="container">

        <div class="d-flex flex-column flex-md-row
                    justify-content-between
                    align-items-md-center
                    mb-4
                    gap-3">

            <div>
                <h2 class="fw-bold mb-1">
                    Photo Gallery
                </h2>

                <p class="text-muted mb-0">
                    Portfolio images and project visuals.
                </p>
            </div>

            <a asp-controller="Gallery"
               asp-action="Index"
               class="btn btn-outline-primary">
                View Full Gallery
            </a>
        </div>

        @if (Model.GalleryItems.Count == 0)
        {
            <div class="text-center py-5 border rounded bg-light">

                <h4>
                    No gallery images yet.
                </h4>

                <p class="text-muted mb-3">
                    Add images to showcase your projects.
                </p>

                <a asp-controller="Gallery"
                   asp-action="Upload"
                   class="btn btn-primary">
                    Upload Image
                </a>

            </div>
        }
        else
        {
            <div class="row g-4">

                @foreach (var item in Model.GalleryItems.Take(6))
                {
                    <div class="col-sm-6 col-lg-4">

                        <div class="card h-100 shadow-sm">

                            <img src="@item.ImagePath"
                                 class="card-img-top gallery-image"
                                 alt="@item.Title"
                                 loading="lazy" />

                            <div class="card-body">

                                <h5 class="card-title">
                                    @item.Title
                                </h5>

                                @if (!string.IsNullOrWhiteSpace(item.Description))
                                {
                                    <p class="card-text text-muted">
                                        @item.Description
                                    </p>
                                }

                            </div>

                        </div>

                    </div>
                }

            </div>

            @if (Model.GalleryItems.Count > 6)
            {
                <div class="text-center mt-4">

                    <a asp-controller="Gallery"
                       asp-action="Index"
                       class="btn btn-primary">
                        View All @Model.GalleryItems.Count Images
                    </a>

                </div>
            }
        }

    </div>

</section>