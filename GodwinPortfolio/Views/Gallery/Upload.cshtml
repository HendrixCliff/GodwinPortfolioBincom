@model GodwinPortfolio.Models.GalleryUploadViewModel

@{
    ViewData["Title"] = "Upload Image";
}

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-lg-7">

            <div class="card shadow-sm">

                <div class="card-body p-4">

                    <h1 class="h2 fw-bold mb-2">
                        Upload Gallery Image
                    </h1>

                    <p class="text-muted mb-4">
                        Add an image to your portfolio gallery.
                    </p>

                    <form asp-controller="Gallery"
                          asp-action="Upload"
                          method="post"
                          enctype="multipart/form-data">

                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="All"
                             class="alert alert-danger"
                             role="alert">
                        </div>

                        <div class="mb-3">

                            <label asp-for="Title"
                                   class="form-label">
                                Image Title
                            </label>

                            <input asp-for="Title"
                                   class="form-control"
                                   maxlength="150" />

                            <span asp-validation-for="Title"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="mb-3">

                            <label asp-for="Description"
                                   class="form-label">
                                Description
                            </label>

                            <textarea asp-for="Description"
                                      class="form-control"
                                      rows="4"
                                      maxlength="500"></textarea>

                            <span asp-validation-for="Description"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="mb-4">

                            <label asp-for="Image"
                                   class="form-label">
                                Select Image
                            </label>

                            <input asp-for="Image"
                                   type="file"
                                   class="form-control"
                                   accept=".jpg,.jpeg,.png,.gif,.webp" />

                            <div class="form-text">
                                Maximum size: 5 MB.
                                Allowed formats: JPG, JPEG, PNG, GIF and WEBP.
                            </div>

                            <span asp-validation-for="Image"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="d-flex gap-2">

                            <button type="submit"
                                    class="btn btn-primary">
                                Upload Image
                            </button>

                            <a asp-controller="Gallery"
                               asp-action="Index"
                               class="btn btn-outline-secondary">
                                Cancel
                            </a>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}